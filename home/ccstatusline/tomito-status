#!/bin/sh
# Prints the Tomito pomodoro timer for a ccstatusline custom-command widget; nothing when Tomito isn't running.
pgrep -x Tomito >/dev/null 2>&1 || exit 0

state=$(osascript -e 'tell application "Tomito" to (getCurrentActivityType) & "|" & (getRemainingTime)' 2>/dev/null) || exit 0
activity=${state%%|*}
remaining=${state#*|}

# Tomito can't report "paused", so compare with the previous run: an unchanged clock over 1.5s isn't ticking.
cache="${TMPDIR:-/tmp}/tomito-status.last"
now=$(perl -MTime::HiRes=time -e 'printf "%d", time*1000')
[ -f "$cache" ] && read -r last_state last_at < "$cache"
paused=""
if [ "$last_state" = "$state" ] && [ $((now - last_at)) -gt 1500 ]; then
  paused=" ⏸"
else
  [ "$last_state" = "$state" ] || printf '%s %s\n' "$state" "$now" > "$cache"
fi

case $activity in
  *[Ss]ession*) printf '🍅 %s%s\n' "$remaining" "$paused" ;;
  *) printf '☕ %s%s\n' "$remaining" "$paused" ;;
esac
