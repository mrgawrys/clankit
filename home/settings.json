{
  "cleanupPeriodDays": 10000,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff *)",
      "Bash(gh run view *)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(docker ps:*)",
      "Bash(npx nx:*)",
      "Bash(npx tsc:*)",
      "Bash(npx prettier:*)",
      "Bash(npx eslint:*)",
      "Bash(npx jest:*)",
      "Bash(pnpm exec:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm storybook:*)",
      "Bash(mise exec -- mix compile *)",
      "Bash(mise exec -- mix test *)",
      "Bash(mise exec -- mix format *)",
      "Bash(mise exec -- mix deps.get *)",
      "Bash(mise exec -- mix ecto.migrate *)",
      "Skill(code-review:code-review)"
    ],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "revdiff@revdiff": true
  },
  "extraKnownMarketplaces": {
    "revdiff": {
      "source": {
        "source": "github",
        "repo": "umputun/revdiff"
      }
    }
  },
  "spinnerVerbs": {
    "mode": "append",
    "verbs": [
      "Slopping",
      "Slopifying",
      "Clankering",
      "Wubbalubbadubdubing",
      "Hallucinating",
      "Gaslighting",
      "Clankifying",
      "Sloptimizing",
      "Vibe-coding",
      "Bonking",
      "Schwiftying",
      "Squanching",
      "Interdimensional-cabling",
      "Actioning-the-action-items",
      "Bamboozling",
      "Get-schwifty-ing",
      "Tokenmaxing",
      "Slopmaxing",
      "Overthinking",
      "Yapping",
      "Sigma-grinding"
    ]
  },
  "effortLevel": "high",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "voiceEnabled": true
}
