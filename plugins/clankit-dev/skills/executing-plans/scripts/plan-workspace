#!/usr/bin/env bash
# Resolve and ensure the working-tree directory executing-plans uses for one
# plan's short-lived artifacts: the build report, the chunk log, review
# packages, and the derived task file. Print the plan directory's absolute path.
#
# One directory per plan (.clankit/plans/<plan-basename>/) so a follow-up
# plan in the same working tree can never read or overwrite another plan's
# artifacts — a stale report misread as this plan's is a structural failure,
# not a judgment call.
#
# The workspace lives in the working tree (not under .git/) because Claude Code
# treats .git/ as a protected path and denies agent writes there — which blocks
# a builder subagent from writing its report file. A self-ignoring
# .gitignore at .clankit/plans/ keeps every plan's workspace out of
# `git status` and out of accidental commits without modifying any tracked file.
#
# Single source of truth for the workspace location, so the controller and
# review-package cannot drift to different directories.
#
# Usage: plan-workspace PLAN_FILE
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: plan-workspace PLAN_FILE" >&2
  exit 2
fi

plan=$1
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

slug=$(basename "$plan" .md)
[ -n "$slug" ] && [ "$slug" != "." ] && [ "$slug" != ".." ] \
  || { echo "cannot derive a workspace name from: $plan" >&2; exit 2; }

root=$(git rev-parse --show-toplevel)
base="$root/.clankit/plans"
dir="$base/$slug"
mkdir -p "$dir"
printf '*\n' > "$base/.gitignore"
cd "$dir" && pwd
